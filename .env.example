# Copie para .env.local (que nunca vai para o Git) e preencha.

# Modo do app:
#   demo    -> sem backend, dados fictícios no navegador (padrão; versão do portfólio)
#   familia -> dados reais no Supabase (versão privada da família)
NEXT_PUBLIC_MODO=demo

# Só no modo família. Supabase > Project Settings > API Keys.
# A chave publishable vai para o navegador por design: quem protege os dados é o RLS.
# A chave secreta (secret, antiga service_role) NUNCA entra com o prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
